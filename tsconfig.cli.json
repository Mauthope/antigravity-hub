{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022"],
    "outDir": "./dist",
    "rootDir": "./src",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "declaration": true
  },
  "include": [
    "src/cli/**/*",
    "src/agents/**/*",
    "src/importers/**/*",
    "src/license/**/*",
    "src/mcp/**/*",
    "src/types/**/*",
    "src/utils/**/*"
  ],
  "exclude": ["src/app/**/*"]
}
